# Copy to .env and adjust. Never commit .env.
# Required for sessions (or set "secret_key" in gitignored config.json).
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
# Optional: path to JSON auth config (defaults to config.json, else config.example.json)
# MONITOR_CONFIG=/absolute/path/to/config.json

